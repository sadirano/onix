# onix shell integration (generated; do not edit — run 'onix sync')
# Source from $PROFILE: . '/ONIX_HOME/shell/onix.ps1'

$global:onixExe = '/ONIX_EXE'

$onixBin = '/ONIX_HOME/bin'
if (($env:PATH -split ';') -notcontains $onixBin) { $env:PATH = $onixBin + ';' + $env:PATH }

$onixAliasCompleter = {
    param($wordToComplete, $commandAst, $cursorPosition)
    # Only complete the first argument (the alias); leave a command's later
    # arguments to the shell's own file/command completion.
    if ($commandAst.CommandElements.Count -gt 2) { return }
    @(& $global:onixExe --list-names 2>$null) |
        Where-Object { $_ -like "$wordToComplete*" } |
        ForEach-Object {
            [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
        }
}

function global:q { exit }

Register-ArgumentCompleter -Native -CommandName e,ff,o,p,r,s,sg,y -ScriptBlock $onixAliasCompleter
