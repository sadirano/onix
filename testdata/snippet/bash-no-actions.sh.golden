# onix shell integration (generated; do not edit — run 'onix sync')
export ONIX_EXE='/ONIX_EXE'

if [ -n "$BASH_VERSION" ]; then
    _onix_completer() {
        local cur=${COMP_WORDS[COMP_CWORD]}
        local names
        mapfile -t names < <("$ONIX_EXE" --list-names 2>/dev/null)
        COMPREPLY=( $(compgen -W "${names[*]}" -- "$cur") )
    }
elif [ -n "$ZSH_VERSION" ] && command -v compdef >/dev/null 2>&1; then
    _onix_zsh_completer() {
        local line names=()
        while IFS= read -r line; do
            names+=("$line")
        done < <("$ONIX_EXE" --list-names 2>/dev/null)
        compadd -- "${names[@]}"
    }
fi

o() {
    if [ -z "$1" ]; then
        "$ONIX_EXE" --edit
        return
    fi
    local path
    path=$("$ONIX_EXE" "$@")
    if [ $? -eq 0 ]; then
        cd "$path"
    fi
}
e() {
    local alias=$1
    shift
    "$ONIX_EXE" "$alias" --edit "$@"
}
s() {
    local alias=$1
    shift
    "$ONIX_EXE" "$alias" --explore "$@"
}
y() { "$ONIX_EXE" "$1" --yank; }
p() {
    local alias=$1
    shift
    "$ONIX_EXE" "$alias" --paste "$@"
}
r() {
    local alias=$1
    shift
    "$ONIX_EXE" "$alias" --run "$@"
}
sg() {
    local alias=$1
    shift
    "$ONIX_EXE" "$alias" --grep "$@"
}
ff() {
    local alias=$1
    shift
    "$ONIX_EXE" "$alias" --find "$@"
}

if [ -n "$BASH_VERSION" ]; then
    complete -F _onix_completer e ff o p r s sg y
elif [ -n "$ZSH_VERSION" ] && command -v compdef >/dev/null 2>&1; then
    compdef _onix_zsh_completer e ff o p r s sg y
fi
